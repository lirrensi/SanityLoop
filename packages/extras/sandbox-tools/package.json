{
  "name": "@sanityloop/sandbox-tools",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Run read/edit/write/bash inside an existing container while the loop stays on the host — per-tool exec transport, in-image SDK, path translation",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --experimental-transform-types --test --test-force-exit \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@sanityloop/basic-fs-tools": "^0.1.0",
    "@sanityloop/core": "^0.2.0",
    "@sanityloop/shell-tool": "^0.1.0",
    "@sanityloop/util": "^0.1.0",
    "dockerode": "^5.0.1"
  },
  "files": [
    "**/*.ts",
    "sdk/cli.cjs",
    "Dockerfile.sandbox.ref",
    "!test",
    "!**/test/**"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.2"
  }
}
